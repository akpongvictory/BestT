generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===============================
// USERS
// ===============================

model User {
  id String @id @default(uuid())

  name     String
  email    String @unique
  password String

  emailVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses Course[]
  documents Document[]
  quizAttempts QuizAttempt[]
  chatSessions ChatSession[]
  progress Progress[]

  verificationTokens EmailVerificationToken[]
}

model EmailVerificationToken {
  id String @id @default(uuid())

  tokenHash String @unique

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ===============================
// COURSES
// ===============================

model Course {
  id String @id @default(uuid())

  title String

  description String?

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  documents Document[]

  quizzes Quiz[]

  chatSessions ChatSession[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

// ===============================
// DOCUMENTS
// ===============================

enum DocumentType {
  FILE
  WEBPAGE
  YOUTUBE
}

enum DocumentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Document {
  id String @id @default(uuid())

  filename     String?
  originalName String

  fileUrl   String?
  sourceUrl String?

  fileType String?
  fileSize Int?
  fileHash String?

  type DocumentType @default(FILE)

  title       String?
  description String?

  processingStatus DocumentStatus @default(PENDING)

  courseId String
  userId   String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  chunks DocumentChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, processingStatus])
  @@index([courseId, type])
  @@index([userId, sourceUrl])
}

// ===============================
// DOCUMENT CHUNKS
// ===============================

model DocumentChunk {
  id String @id @default(uuid())

  content String

  embedding Unsupported("vector(768)")?

  chunkIndex Int

  documentId String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([documentId])
}

// ===============================
// AI TUTOR CHAT
// ===============================

model ChatSession {
  id String @id @default(uuid())

  title String?

  userId   String
  courseId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  messages ChatMessage[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId, courseId])
}

model ChatMessage {
  id String @id @default(uuid())

  role ChatRole

  content String

  sessionId String

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum ChatRole {
  USER

  ASSISTANT
}

// ===============================
// QUIZ
// ===============================

model Quiz {
  id String @id @default(uuid())

  title String

  description String?

  courseId String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  questions Question[]

  attempts QuizAttempt[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

// ===============================
// QUESTIONS
// ===============================

model Question {
  id String @id @default(uuid())

  question String

  options Json

  answer String

  explanation String?

  quizId String

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ===============================
// QUIZ ATTEMPTS
// ===============================

model QuizAttempt {
  id String @id @default(uuid())

  score Int

  totalQuestions Int

  answers Json?

  userId String

  quizId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ===============================
// PROGRESS TRACKING
// ===============================

model Progress {
  id String @id @default(uuid())

  activity String

  value Int @default(0)

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
